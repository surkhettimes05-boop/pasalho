# REQUIRED outside development: use the pasalo logical database on the shared PostgreSQL server.
# Production must name the pasalo logical database on the shared PostgreSQL server.
# DEVELOPMENT ONLY with `docker compose --profile development`:
DB_USER=USER
DB_PASSWORD=PASSWORD
DB_NAME=pasalo
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/pasalo

# REQUIRED: use a unique secret of at least 32 characters in production. Never commit its value.
JWT_SECRET=<generate-a-unique-secret-of-at-least-32-characters>
JWT_EXPIRATION=24h

# Environment
NODE_ENV=development
PORT=3000
# Development defaults to no trusted proxy. Production must explicitly set this to exactly 1.
TRUST_PROXY_HOPS=0
ONLINE_ORDER_BRANCH_ID=<pasalo-branch-id-for-online-warehouse>

# REQUIRED: production uses the shared Redis endpoint; Commerce uses its own key namespace.
# DEVELOPMENT ONLY with `docker compose --profile development`:
REDIS_URL=redis://redis:6379

# API
API_PREFIX=api
API_VERSION=v1

# REQUIRED in production: comma-separated HTTPS origins for trusted browser frontends.
# DEVELOPMENT ONLY:
CORS_ORIGIN=http://localhost:8080,http://localhost:3001

# REQUIRED production frontend build/runtime value; use the HTTPS public API URL.
# DEVELOPMENT ONLY value for the local Compose stack:
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Bind the internal HTTP gateway to loopback by default; the TLS proxy should be its only client.
NGINX_PASALO_BIND_ADDRESS=127.0.0.1
NGINX_PASALO_HOST_PORT=8080

# Logging
LOG_LEVEL=debug

# Cloudinary
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# REQUIRED for CEO → PASALO transfer sync and receipt acknowledgement in production.
# STORE_SYNC_WEBHOOK_SECRET must equal CEO PASALO_WEBHOOK_SECRET.
STORE_SYNC_WEBHOOK_URL=https://ceodashboard.example.com/api/sync/inbound-transfers
STORE_SYNC_WEBHOOK_SECRET=replace-with-the-same-secret-as-ceo-dashboard-PASALO_WEBHOOK_SECRET

# REQUIRED when Commerce → PASALO checkout is enabled. Must equal Commerce PASALHO_API_KEY.
PASALO_INTEGRATION_SECRET=replace-with-at-least-32-bytes
PASALO_REPORTING_API_TOKEN=replace-with-at-least-32-bytes-for-ceo-reporting

# REQUIRED by the production pilot for CEO physical-store fulfillment. Uses STORE_SYNC_WEBHOOK_SECRET.
CEO_ONLINE_ORDER_URL=https://ceodashboard.example.com/api/sync
CEO_ONLINE_ORDER_TIMEOUT_MS=10000

# REQUIRED only when an online order request does not specify branchId.
