# Database
DATABASE_URL=postgresql://pasalo:pasalo_dev@localhost:5432/pasalo_dev

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# Environment
NODE_ENV=development
PORT=3000

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PREFIX=api
API_VERSION=v1

# CORS
CORS_ORIGIN=http://localhost:3001

# Logging
LOG_LEVEL=debug

# Cloudinary
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>


# Customer commerce auth
# Use a different secret from employee JWT_SECRET in production.
CUSTOMER_JWT_SECRET=change-this-customer-jwt-secret-in-production
CUSTOMER_JWT_TTL_SECONDS=900
CUSTOMER_REFRESH_TOKEN_DAYS=30

# OTP: console is development-only. Production config requires sms.
OTP_PROVIDER=console
OTP_SMS_WEBHOOK_URL=
OTP_SMS_WEBHOOK_TOKEN=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Existing employee/system actor used for immutable audit relationships until
# customer-native actor relations are added to every legacy table.
STOREFRONT_SYSTEM_USER_ID=

# Customer cart lifetime
CART_TTL_HOURS=72
